{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AT Protocol OAuth Client Metadata",
  "description": "Project-derived validation schema for the AT Protocol OAuth Client ID Metadata Document profile, Clients section. This schema is not published by the protocol authors.",
  "type": "object",
  "required": [
    "client_id",
    "client_name",
    "client_uri",
    "redirect_uris",
    "grant_types",
    "response_types",
    "scope",
    "token_endpoint_auth_method",
    "dpop_bound_access_tokens"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "format": "uri",
      "description": "HTTPS URL where this client metadata document is hosted."
    },
    "client_name": {
      "type": "string",
      "description": "Human-readable name of the application."
    },
    "client_uri": {
      "type": "string",
      "format": "uri",
      "description": "URL of the application homepage."
    },
    "logo_uri": {
      "type": "string",
      "format": "uri",
      "description": "URL of the application logo image."
    },
    "tos_uri": {
      "type": "string",
      "format": "uri",
      "description": "URL of the application terms of service."
    },
    "policy_uri": {
      "type": "string",
      "format": "uri",
      "description": "URL of the application privacy policy."
    },
    "redirect_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1,
      "description": "List of allowed redirection URIs."
    },
    "grant_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "OAuth grant types (e.g. ['authorization_code', 'refresh_token'])."
    },
    "response_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "OAuth response types (e.g. ['code'])."
    },
    "scope": {
      "type": "string",
      "description": "Space-separated OAuth scopes requested by client (e.g. 'atproto')."
    },
    "token_endpoint_auth_method": {
      "type": "string",
      "enum": [
        "none",
        "client_secret_basic",
        "client_secret_post",
        "private_key_jwt"
      ],
      "description": "Requested authentication method for token endpoint."
    },
    "dpop_bound_access_tokens": {
      "type": "boolean",
      "description": "Indicates whether client requires DPoP-bound access tokens."
    },
    "application_type": {
      "type": "string",
      "enum": [
        "web",
        "native"
      ],
      "description": "Client application type."
    },
    "jwks_uri": {
      "type": "string",
      "format": "uri",
      "description": "URL for the client's JSON Web Key Set."
    }
  },
  "additionalProperties": true
}
